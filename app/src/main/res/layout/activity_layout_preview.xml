<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_theme_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_preview_theme_toggle"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Theme" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#E0E0E0"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Fullscreen ImageView for Drawables/SVG (Outside phone_frame) -->
            <ImageView
                android:id="@+id/preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <!-- Phone Frame Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/phone_frame"
                android:layout_width="360dp"
                android:layout_height="780dp"
                android:layout_gravity="center"
                android:layout_margin="16dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="16dp"
                app:strokeWidth="8dp"
                app:strokeColor="#212121"
                app:cardBackgroundColor="?attr/colorSurface">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="true">

                    <!-- [LAYER 1] Content Area (Edge-to-Edge) -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="true">

                        <!-- Fake Toolbar for Menu Preview (Child pertama) -->
                        <com.google.android.material.appbar.MaterialToolbar
                            android:id="@+id/preview_menu_toolbar"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/actionBarSize"
                            android:layout_marginTop="28dp"
                            android:background="?attr/colorPrimary"
                            app:titleTextColor="?attr/colorOnPrimary"
                            android:visibility="gone" />

                        <!-- ViewPane for Layouts -->
                        <com.besome.sketch.editor.view.ViewPane
                            android:id="@+id/pane"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </FrameLayout>

                    <!-- [LAYER 2] Status Bar Overlay -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_gravity="top"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="#33000000">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="12:00"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.85" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4G"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginEnd="6dp"
                            android:alpha="0.85" />

                        <!-- Fake Signal -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginEnd="8dp">
                            <View
                                android:layout_width="2.5dp"
                                android:layout_height="3.5dp"
                                android:background="?attr/colorOnSurface"
                                android:layout_marginEnd="1.5dp"
                                android:alpha="0.85" />
                            <View
                                android:layout_width="2.5dp"
                                android:layout_height="6dp"
                                android:background="?attr/colorOnSurface"
                                android:layout_marginEnd="1.5dp"
                                android:alpha="0.85" />
                            <View
                                android:layout_width="2.5dp"
                                android:layout_height="9dp"
                                android:background="?attr/colorOnSurface"
                                android:layout_marginEnd="1.5dp"
                                android:alpha="0.85" />
                            <View
                                android:layout_width="2.5dp"
                                android:layout_height="12dp"
                                android:background="?attr/colorOnSurface"
                                android:alpha="0.85" />
                        </LinearLayout>

                        <!-- Battery Indicator Drawable -->
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="11dp"
                            android:src="@drawable/battery_indicator"
                            app:tint="?attr/colorOnSurface"
                            android:alpha="0.85"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <!-- [LAYER 3] Navigation Bar Overlay -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom"
                        android:background="#33000000">

                        <View
                            android:layout_width="120dp"
                            android:layout_height="4dp"
                            android:layout_gravity="center"
                            android:background="@drawable/nav_pill_indicator"
                            android:alpha="0.85" />
                    </FrameLayout>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>