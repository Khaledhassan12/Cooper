<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                
                <ImageView
                    android:id="@+id/btn_theme_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_preview_theme_toggle"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Theme" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#E0E0E0"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <!-- Phone Frame Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/phone_frame"
                android:layout_width="360dp"
                android:layout_height="760dp"
                android:layout_gravity="center"
                android:layout_margin="16dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="16dp"
                app:strokeWidth="8dp"
                app:strokeColor="#212121"
                app:cardBackgroundColor="?attr/colorSurface">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    
                    <!-- Fake Status Bar (Realistic Vector Look) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="#10000000">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="12:00"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.8"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4G"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginEnd="6dp"
                            android:alpha="0.8"/>
                            
                        <!-- Fake Signal -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginEnd="8dp">
                            <View android:layout_width="3dp" android:layout_height="4dp" android:background="?attr/colorOnSurface" android:layout_marginEnd="2dp" android:alpha="0.8"/>
                            <View android:layout_width="3dp" android:layout_height="7dp" android:background="?attr/colorOnSurface" android:layout_marginEnd="2dp" android:alpha="0.8"/>
                            <View android:layout_width="3dp" android:layout_height="10dp" android:background="?attr/colorOnSurface" android:layout_marginEnd="2dp" android:alpha="0.8"/>
                            <View android:layout_width="3dp" android:layout_height="14dp" android:background="?attr/colorOnSurface" android:alpha="0.8"/>
                        </LinearLayout>
                        
                        <!-- Fake Battery -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="22dp"
                                android:layout_height="12dp"
                                app:cardCornerRadius="2dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1.5dp"
                                app:strokeColor="?attr/colorOnSurface"
                                app:cardBackgroundColor="@android:color/transparent"
                                android:alpha="0.8">
                                <View
                                    android:layout_width="16dp"
                                    android:layout_height="match_parent"
                                    android:layout_margin="1.5dp"
                                    android:background="?attr/colorOnSurface" />
                            </com.google.android.material.card.MaterialCardView>
                            <View
                                android:layout_width="1.5dp"
                                android:layout_height="5dp"
                                android:background="?attr/colorOnSurface"
                                android:alpha="0.8"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fake Toolbar for Menu Preview -->
                    <com.google.android.material.appbar.MaterialToolbar
                        android:id="@+id/preview_menu_toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        android:background="?attr/colorPrimary"
                        app:titleTextColor="?attr/colorOnPrimary"
                        android:visibility="gone" />

                    <!-- Content Area -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipChildren="true">
                        
                        <!-- ViewPane for Layouts -->
                        <com.besome.sketch.editor.view.ViewPane
                            android:id="@+id/pane"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                            
                        <!-- ImageView for Drawables/SVG -->
                        <ImageView
                            android:id="@+id/preview_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:scaleType="centerInside"
                            android:visibility="gone" />
                            
                    </FrameLayout>
                    
                    <!-- Fake Navigation Bar (Modern Pill Style) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="#10000000">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="120dp"
                            android:layout_height="4dp"
                            app:cardCornerRadius="2dp"
                            app:cardBackgroundColor="?attr/colorOnSurface"
                            app:cardElevation="0dp"
                            android:alpha="0.8" />
                    </LinearLayout>
                    
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>